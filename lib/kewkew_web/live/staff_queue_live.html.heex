<Layouts.app
  flash={@flash}
  staff?={true}
  staff_email={to_string(@current_user.email)}
  location_name={@location.name}
>
  <section id="staff-queue-board" class="staff-page">
    <header class="staff-page-heading">
      <div>
        <.link navigate={~p"/staff"} class="staff-back-link">
          <.icon name="hero-arrow-left" class="size-4" /> All queues
        </.link>
        <p class="staff-eyebrow">{@location.name} · {@service.name}</p>
        <h1 id="staff-queue-name">{@queue.name}</h1>
        <p class="staff-subhead">Monitor visitors as they move through this queue.</p>
      </div>
      <div class="staff-heading-actions">
        <button
          id="staff-call-next"
          type="button"
          class="staff-primary-button"
          phx-click="call_next"
          disabled={@waiting_count == 0}
        >
          <.icon name="hero-megaphone" class="size-4" /> Call next visitor
        </button>
        <span
          id="staff-queue-session-status"
          class={["staff-session-status", session_status_class(@session)]}
        >
          <span class="staff-status-dot"></span>{@session_status}
        </span>
        <button
          id="staff-queue-refresh"
          type="button"
          class="staff-secondary-button"
          phx-click="refresh"
        >
          <.icon name="hero-arrow-path" class="size-4" /> Refresh
        </button>
      </div>
    </header>

    <section aria-label="Queue counts" class="staff-stats">
      <article class="staff-card staff-stat-card">
        <span class="staff-stat-icon mint"><.icon name="hero-user-group" class="size-5" /></span>
        <p class="staff-stat-label">Waiting</p>
        <p id="staff-waiting-count" class="staff-stat-value">{@waiting_count}</p>
        <p class="staff-stat-note">Visitors in line</p>
      </article>
      <article class="staff-card staff-stat-card">
        <span class="staff-stat-icon amber"><.icon name="hero-megaphone" class="size-5" /></span>
        <p class="staff-stat-label">Called</p>
        <p id="staff-called-count" class="staff-stat-value">{@called_count}</p>
        <p class="staff-stat-note">Ready to be served</p>
      </article>
      <article class="staff-card staff-stat-card">
        <span class="staff-stat-icon mint"><.icon name="hero-hand-raised" class="size-5" /></span>
        <p class="staff-stat-label">Being served</p>
        <p id="staff-serving-count" class="staff-stat-value">{@serving_count}</p>
        <p class="staff-stat-note">Currently with staff</p>
      </article>
    </section>

    <section aria-labelledby="queue-visitors-heading" class="staff-card staff-visitors-card">
      <div class="staff-card-heading">
        <div>
          <h2 id="queue-visitors-heading">Queue visitors</h2>
          <p>Current visitors, updated automatically</p>
        </div>
        <span class="staff-total-visitors">{@active_count} active</span>
      </div>

      <div :if={@session_status != "Open"} class="staff-queue-notice">
        <.icon name="hero-information-circle" class="size-5" />
        <span>
          This queue is {@session_status |> String.downcase()}. Visitor activity may be limited.
        </span>
      </div>

      <p :if={@waiting_count == 0 and @active_count > 0} class="staff-no-waiting">
        Nobody is waiting for a call right now.
      </p>
      <div id="staff-tickets" phx-update="stream" class="staff-ticket-list">
        <p id="staff-tickets-empty" class="staff-empty-state hidden only:flex">
          <span class="staff-empty-icon"><.icon name="hero-user-group" class="size-6" /></span>
          <strong>No active visitors</strong>
          <span>Visitors will appear here when they join the queue.</span>
        </p>
        <article :for={{id, ticket} <- @streams.tickets} id={id} class="staff-ticket-row">
          <span class="staff-ticket-number">#{ticket.ticket_number}</span>
          <span class="staff-ticket-person">
            <span class="staff-person-avatar">{person_initials(ticket, @show_names?)}</span>
            <span>
              <strong :if={@show_names? and ticket.first_name}>
                {ticket.first_name} {ticket.last_name}
              </strong>
              <strong :if={!@show_names? or is_nil(ticket.first_name)}>Visitor</strong>
              <small>{ticket_status_description(ticket.status)}</small>
            </span>
          </span>
          <span class="staff-ticket-actions">
            <button
              :if={ticket.status == :called}
              type="button"
              class="staff-row-action"
              phx-click="start_serving"
              phx-value-ticket-id={ticket.id}
              aria-label={"Start serving ticket ##{ticket.ticket_number}"}
              title="Start serving"
            >
              <.icon name="hero-play" class="size-4" />
            </button>
            <button
              :if={ticket.status == :called}
              type="button"
              class="staff-row-action skip"
              phx-click="skip_visitor"
              phx-value-ticket-id={ticket.id}
              aria-label={"Skip ticket ##{ticket.ticket_number}"}
              title="Skip visitor"
            >
              <.icon name="hero-forward" class="size-4" />
            </button>
            <button
              :if={ticket.status in [:waiting, :called]}
              type="button"
              class="staff-row-action cancel"
              phx-click="cancel_ticket"
              phx-value-ticket-id={ticket.id}
              data-confirm={"Cancel ticket ##{ticket.ticket_number}? This cannot be undone."}
              aria-label={"Cancel ticket ##{ticket.ticket_number}"}
              title="Cancel ticket"
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
            <button
              :if={ticket.status == :serving}
              type="button"
              class="staff-row-action"
              phx-click="complete_service"
              phx-value-ticket-id={ticket.id}
              aria-label={"Complete service for ticket ##{ticket.ticket_number}"}
              title="Complete service"
            >
              <.icon name="hero-check" class="size-4" />
            </button>
            <span class={["staff-status-pill", ticket_status_class(ticket.status)]}>
              {ticket_status_label(ticket.status)}
            </span>
          </span>
        </article>
      </div>
    </section>
  </section>
</Layouts.app>
