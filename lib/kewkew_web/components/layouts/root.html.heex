<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Kewkew" suffix=" · Kewkew">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

        const setSystemTheme = () => {
          document.documentElement.setAttribute("data-theme", systemTheme.matches ? "dark" : "light");
          document.documentElement.dataset.kewkewTheme = "system";
        };

        const updateThemeControls = (theme) => {
          document.querySelectorAll("[data-phx-theme]").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.phxTheme === theme));
          });
        };

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            setSystemTheme();
          } else if (theme === "light" || theme === "dark") {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.removeAttribute("data-kewkew-theme");
          }
          updateThemeControls(theme);
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        systemTheme.addEventListener("change", () => {
          if (!localStorage.getItem("phx:theme")) {
            setSystemTheme();
            updateThemeControls("system");
          }
        });

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        document.addEventListener("DOMContentLoaded", () => {
          updateThemeControls(localStorage.getItem("phx:theme") || "system");
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
