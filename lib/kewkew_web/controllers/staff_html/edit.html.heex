<Layouts.app flash={@flash} staff?={true} staff_email={@staff_email}>
  <section id="staff-edit-queue" class="staff-page">
    <header class="staff-page-heading">
      <div>
        <.link navigate={~p"/staff"} class="staff-back-link">
          <.icon name="hero-arrow-left" class="size-4" /> All queues
        </.link>
        <p class="staff-eyebrow">Queue setup</p>
        <h1>Edit queue</h1>
        <p class="staff-subhead">Update settings for {@context.queue.name}.</p>
      </div>
    </header>

    <section class="staff-card staff-create-queue-card">
      <div class="staff-card-heading">
        <div>
          <h2>Queue details</h2>
          <p>Location and service are fixed for this queue.</p>
        </div>
      </div>

      <div
        :if={@errors != []}
        id="staff-edit-queue-errors"
        class="staff-form-errors"
        role="alert"
      >
        <p>Review the queue details below:</p>
        <ul>
          <li :for={{_field, message} <- @errors}>{message}</li>
        </ul>
      </div>

      <.form
        for={@form}
        id="staff-edit-queue-form"
        action={~p"/staff/queues/#{@context.queue.id}"}
        method="put"
        class="staff-create-queue-form"
      >
        <div class="staff-form-location">
          <span class="staff-form-label">Location</span>
          <strong>{@context.location.name}</strong>
        </div>

        <div class="staff-form-location">
          <span class="staff-form-label">Service</span>
          <strong>{@context.service.name}</strong>
        </div>

        <.input field={@form[:name]} label="Queue name" autocomplete="off" />

        <.input
          field={@form[:identity_policy]}
          type="select"
          label="Visitor identity"
          options={[
            {"Anonymous ticket", "anonymous"},
            {"First and last name required", "name_required"}
          ]}
        />

        <.input
          field={@form[:max_active_tickets]}
          type="number"
          label="Maximum active visitors (optional)"
          min="1"
          step="1"
          placeholder="No limit"
        />

        <p class="staff-form-note">
          Changes apply to future joins. Existing tickets are unchanged. Lowering capacity below the current active count blocks new joins until the count drops under the limit.
        </p>

        <div class="staff-form-actions">
          <.link navigate={~p"/staff"} class="staff-secondary-button">Cancel</.link>
          <button id="staff-save-queue-settings" type="submit" class="staff-primary-button">
            Save changes
          </button>
        </div>
      </.form>
    </section>

    <section id="staff-queue-access" class="staff-card staff-queue-access-card">
      <div class="staff-card-heading">
        <div>
          <h2>Visitor access</h2>
          <p>This reusable queue link continues to work for future sessions.</p>
        </div>
      </div>

      <div id="staff-queue-qr-print" class="staff-queue-access-content">
        <div class="staff-queue-print-heading">
          <p>Kewkew · {@context.location.name}</p>
          <h2>{@context.queue.name}</h2>
          <p>Scan to join this queue</p>
        </div>

        <div class="staff-public-link">
          <.input
            field={@public_url_form[:url]}
            type="url"
            label="Public join link"
            readonly
            id="staff-public-queue-url"
          />
          <button
            id="staff-copy-public-queue-url"
            type="button"
            class="staff-secondary-button"
            data-copy-target="staff-public-queue-url"
            data-copy-status="staff-public-queue-url-status"
            data-copy-value={@public_url}
            data-copy-message="Public queue link copied."
            data-copy-fallback="Select and copy the public queue link."
          >
            <.icon name="hero-clipboard-document" class="size-4" /> Copy link
          </button>
          <p
            id="staff-public-queue-url-status"
            class="staff-form-note"
            role="status"
            aria-live="polite"
          >
          </p>
        </div>

        <div class="staff-queue-qr-panel">
          <div
            id="staff-queue-qr"
            data-queue-url={@public_url}
            data-queue-slug={@context.queue.public_slug}
          >
            <p id="staff-queue-qr-fallback" class="staff-form-note">
              The QR code will appear here when JavaScript is available.
            </p>
          </div>
          <div class="staff-queue-qr-actions">
            <button
              id="staff-download-queue-qr"
              type="button"
              class="staff-secondary-button"
              data-download-queue-qr
              hidden
            >
              <.icon name="hero-arrow-down-tray" class="size-4" /> Download SVG
            </button>
            <button
              id="staff-print-queue-qr"
              type="button"
              class="staff-secondary-button"
              data-print-queue-qr
              hidden
            >
              <.icon name="hero-printer" class="size-4" /> Print QR code
            </button>
          </div>
        </div>
      </div>
    </section>
  </section>
</Layouts.app>
