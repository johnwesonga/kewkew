<Layouts.app
  flash={@flash}
  staff?={true}
  staff_email={@staff_email}
  can_setup?={@can_setup?}
  active_nav={:queues}
>
  <section id="staff-live-queues" class="staff-page">
    <header class="staff-page-heading">
      <div>
        <p class="staff-eyebrow">Operations</p>
        <h1>Live queues</h1>
        <p class="staff-subhead">Choose a queue to monitor visitors and manage service.</p>
      </div>
      <span id="staff-queue-count" class="staff-assignment-count">
        {@queue_count} {if @queue_count == 1, do: "queue", else: "queues"}
      </span>
    </header>

    <section :if={@queues == []} id="staff-no-live-queues" class="staff-card">
      <p class="staff-empty-state">
        <span class="staff-empty-icon"><.icon name="hero-queue-list" class="size-6" /></span>
        <strong>No live queues are assigned to this account</strong>
        <span>Ask an administrator to assign a location or set up a queue.</span>
      </p>
    </section>

    <div :if={@queues != []} id="staff-live-queue-groups" class="staff-queue-groups">
      <section
        :for={entry <- @queues}
        id={"staff-live-queue-#{entry.queue.id}"}
        class="staff-card staff-live-queue-card"
      >
        <% {status, status_class} = queue_status(entry) %>
        <div class="staff-live-queue-context">
          <p class="staff-eyebrow">{entry.organization.name}</p>
          <h2>{entry.queue.name}</h2>
          <p>{entry.location.name} · {entry.service.name}</p>
        </div>
        <span class={["staff-queue-status", status_class]}>{status}</span>
        <.link
          id={"staff-open-live-queue-#{entry.queue.id}"}
          navigate={~p"/staff/queues/#{entry.queue.id}"}
          class="staff-primary-button"
        >
          Open queue board <.icon name="hero-arrow-right" class="size-4" />
        </.link>
      </section>
    </div>
  </section>
</Layouts.app>
