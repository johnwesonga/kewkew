<Layouts.app
  flash={@flash}
  staff?={true}
  staff_email={@staff_email}
  can_setup?={true}
  active_nav={:setup}
>
  <section id="staff-setup-home" class="staff-page">
    <header class="staff-page-heading">
      <div>
        <p class="staff-eyebrow">Administrator workspace</p>
        <h1>Setup overview</h1>
        <p class="staff-subhead">Choose an area to manage your organization.</p>
      </div>
    </header>

    <div class="staff-setup-grid">
      <.link navigate={~p"/staff/setup/locations"} class="staff-card staff-setup-card">
        <span class="staff-setup-card-icon"><.icon name="hero-map-pin" class="size-5" /></span>
        <strong>Locations</strong>
        <span>
          {@location_count} {if @location_count == 1, do: "location", else: "locations"}
        </span>
        <small>Manage sites and availability</small>
      </.link>
      <.link navigate={~p"/staff/setup/queues"} class="staff-card staff-setup-card">
        <span class="staff-setup-card-icon"><.icon name="hero-queue-list" class="size-5" /></span>
        <strong>Queues</strong>
        <span>{@queue_count} {if @queue_count == 1, do: "queue", else: "queues"}</span>
        <small>Configure visitor-facing queues</small>
      </.link>
      <.link navigate={~p"/staff/setup/services"} class="staff-card staff-setup-card">
        <span class="staff-setup-card-icon">
          <.icon name="hero-wrench-screwdriver" class="size-5" />
        </span>
        <strong>Services</strong>
        <span>{@service_count} {if @service_count == 1, do: "service", else: "services"}</span>
        <small>Manage services across your locations</small>
      </.link>
      <.link navigate={~p"/staff/setup/staff"} class="staff-card staff-setup-card">
        <span class="staff-setup-card-icon"><.icon name="hero-users" class="size-5" /></span>
        <strong>Staff access</strong>
        <span>{@member_count} {if @member_count == 1, do: "member", else: "members"}</span>
        <small>Invite staff and manage access</small>
      </.link>
    </div>

    <section class="staff-card staff-setup-organizations">
      <header class="staff-card-heading">
        <div>
          <h2>Organizations</h2>
          <p>{@organization_count} organizations you administer</p>
        </div>
      </header>
      <ul class="staff-setup-organization-list">
        <li :for={entry <- @organizations}>
          <span>
            <strong>{entry.organization.name}</strong><small>Organization profile and settings</small>
          </span>
          <.link
            navigate={~p"/staff/organizations/#{entry.organization.id}/edit"}
            class="staff-edit-queue-link"
          >
            Edit organization
          </.link>
        </li>
      </ul>
    </section>
  </section>
</Layouts.app>
