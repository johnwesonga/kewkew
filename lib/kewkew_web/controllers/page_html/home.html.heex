<div id="landing-page" class="min-h-screen overflow-hidden bg-[#f7faf7] text-[#17251f]">
  <header class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8 lg:px-10">
    <a href="/" class="inline-flex items-center gap-3" aria-label="Kewkew home">
      <span class="grid size-11 place-items-center rounded-2xl bg-[#176b4b] text-xl font-black text-white shadow-sm">
        k
      </span>
      <span class="text-lg font-extrabold tracking-tight">kewkew</span>
    </a>
    <nav
      class="hidden items-center gap-8 text-sm font-semibold text-[#5f6d64] md:flex"
      aria-label="Main navigation"
    >
      <a href="#features" class="transition hover:text-[#176b4b]">Features</a>
      <a href="#how-it-works" class="transition hover:text-[#176b4b]">How it works</a>
      <a href="#for-businesses" class="transition hover:text-[#176b4b]">For businesses</a>
    </nav>
    <a
      id="landing-staff-sign-in"
      href="/staff"
      class="rounded-xl border border-[#d8e4db] bg-white px-4 py-2.5 text-sm font-bold text-[#176b4b] shadow-sm transition hover:border-[#a9cbb7] hover:bg-[#f1f8f3]"
    >
      Staff sign in
    </a>
  </header>

  <main>
    <section class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 pb-16 pt-10 sm:px-8 sm:pb-24 sm:pt-14 lg:grid-cols-[1.02fr_.98fr] lg:gap-16 lg:px-10 lg:pb-32 lg:pt-20">
      <div class="relative z-10">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#d9e9de] bg-white px-3.5 py-2 text-xs font-bold text-[#176b4b] shadow-sm">
          <span class="size-2 rounded-full bg-[#45ac73]"></span> A simpler way to manage the line
        </p>
        <h1
          id="landing-hero-title"
          class="max-w-2xl text-5xl font-black leading-[1.02] tracking-[-.065em] sm:text-6xl lg:text-7xl"
        >
          Less waiting around. <span class="text-[#218158]">More life in line.</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-[#647168] sm:text-lg sm:leading-8">
          Kewkew helps businesses organize busy queues and keep visitors in the know. Join from your phone, follow your place, and get on with your day—no app to install.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#176b4b] px-5 py-3.5 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(23,107,75,.2)] transition hover:bg-[#10523a]"
          >
            See how it works <.icon name="hero-arrow-right" class="size-4" />
          </a>
          <a
            href="/sign-in"
            class="inline-flex items-center justify-center rounded-xl border border-[#d8e4db] bg-white px-5 py-3.5 text-sm font-extrabold text-[#34463b] transition hover:border-[#a9cbb7] hover:bg-[#f1f8f3]"
          >
            Manage a queue
          </a>
        </div>
        <p class="mt-5 text-xs font-medium text-[#87948b]">
          Have a queue link or QR code? Open it on your phone to get started.
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-xl lg:ml-auto">
        <div class="absolute -right-10 -top-10 size-48 rounded-full bg-[#dff1e5] blur-3xl"></div>
        <div class="absolute -bottom-10 -left-10 size-48 rounded-full bg-[#fbe8d5] blur-3xl">
        </div>
        <div class="relative rounded-[2rem] border border-[#e2eae4] bg-white p-4 shadow-[0_28px_80px_rgba(33,67,47,.13)] sm:p-6">
          <div class="flex items-center justify-between border-b border-[#edf1ed] pb-4">
            <div class="flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-xl bg-[#e6f4ec] text-[#176b4b]">
                <.icon name="hero-map-pin" class="size-5" />
              </span>
              <div>
                <p class="text-sm font-extrabold">Riverside Community Hub</p>
                <p class="mt-0.5 text-xs text-[#87948b]">Food support</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#e6f4ec] px-2.5 py-1.5 text-[10px] font-extrabold text-[#176b4b]">
              <span class="size-1.5 rounded-full bg-[#45ac73]"></span> Open
            </span>
          </div>

          <div class="px-2 py-7 text-center sm:py-9">
            <p class="text-xs font-bold uppercase tracking-[.15em] text-[#87948b]">
              Your queue ticket
            </p>
            <p class="mt-2 text-7xl font-black tracking-[-.07em] text-[#176b4b] sm:text-8xl">
              #08
            </p>
            <p class="mt-3 text-sm font-semibold text-[#526158]">
              You’re in line. We’ll keep you updated.
            </p>
          </div>

          <div class="rounded-2xl bg-[#f4f8f4] p-4 sm:p-5">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-[#526158]">Your place in line</span>
              <span class="text-[#176b4b]">3 people ahead</span>
            </div>
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-[#dfe9e1]">
              <div class="h-full w-2/3 rounded-full bg-[#45ac73]"></div>
            </div>
            <div class="mt-4 flex items-center gap-2 text-xs text-[#647168]">
              <.icon name="hero-arrow-path" class="size-4 text-[#218158]" />
              <span>Your status updates as the queue moves</span>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-between rounded-2xl border border-[#edf1ed] px-4 py-3">
            <span class="text-xs font-semibold text-[#647168]">
              No app. No account. Just your place.
            </span>
            <.icon name="hero-check-circle" class="size-5 text-[#218158]" />
          </div>
        </div>
        <div class="absolute -left-5 top-12 hidden items-center gap-2 rounded-2xl border border-[#e2eae4] bg-white px-4 py-3 text-xs font-bold text-[#34463b] shadow-lg sm:flex">
          <span class="grid size-8 place-items-center rounded-xl bg-[#fff4d8] text-[#936516]">
            <.icon name="hero-bell-alert" class="size-4" />
          </span>
          Your turn is getting closer
        </div>
      </div>
    </section>

    <section
      id="features"
      class="border-y border-[#e8eee9] bg-white px-5 py-16 sm:px-8 sm:py-20 lg:px-10"
    >
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-extrabold uppercase tracking-[.16em] text-[#218158]">
            A better queue, for everyone
          </p>
          <h2 class="mt-3 text-3xl font-black tracking-[-.05em] sm:text-4xl">
            Keep the line moving and people informed.
          </h2>
          <p class="mt-4 text-sm leading-7 text-[#718078] sm:text-base">
            Replace crowded, uncertain waiting with a clear place in line and simple tools for the team serving it.
          </p>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-[#e4ebe5] bg-[#fbfdfb] p-6">
            <span class="grid size-11 place-items-center rounded-2xl bg-[#e6f4ec] text-[#176b4b]">
              <.icon name="hero-qr-code" class="size-5" />
            </span>
            <h3 class="mt-5 text-base font-extrabold">Join in a scan</h3>
            <p class="mt-2 text-sm leading-6 text-[#718078]">
              Visitors scan a QR code or open a link. Nothing to download and no account to create.
            </p>
          </article>
          <article class="rounded-2xl border border-[#e4ebe5] bg-[#fbfdfb] p-6">
            <span class="grid size-11 place-items-center rounded-2xl bg-[#fff4d8] text-[#936516]">
              <.icon name="hero-device-phone-mobile" class="size-5" />
            </span>
            <h3 class="mt-5 text-base font-extrabold">Know where you stand</h3>
            <p class="mt-2 text-sm leading-6 text-[#718078]">
              A private ticket page shows queue status and position, and refreshes as service moves along.
            </p>
          </article>
          <article class="rounded-2xl border border-[#e4ebe5] bg-[#fbfdfb] p-6">
            <span class="grid size-11 place-items-center rounded-2xl bg-[#eaf0ff] text-[#4c62a8]">
              <.icon name="hero-queue-list" class="size-5" />
            </span>
            <h3 class="mt-5 text-base font-extrabold">Serve in order</h3>
            <p class="mt-2 text-sm leading-6 text-[#718078]">
              Staff see the live line and can call, serve, complete, or resolve tickets from one queue board.
            </p>
          </article>
          <article class="rounded-2xl border border-[#e4ebe5] bg-[#fbfdfb] p-6">
            <span class="grid size-11 place-items-center rounded-2xl bg-[#fcebe9] text-[#ba5448]">
              <.icon name="hero-building-storefront" class="size-5" />
            </span>
            <h3 class="mt-5 text-base font-extrabold">Fit your business</h3>
            <p class="mt-2 text-sm leading-6 text-[#718078]">
              Organize queues by location and service, with staff access scoped to the places they work.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section
      id="how-it-works"
      class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-20 lg:px-10 lg:py-24"
    >
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[.16em] text-[#218158]">
          For visitors
        </p>
        <h2 class="mt-3 text-3xl font-black tracking-[-.05em] sm:text-4xl">
          Take your place, then take a breath.
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-7 text-[#718078] sm:text-base">
          The queue comes to your phone. Join with the information the business asks for, save your private ticket link, and check your place whenever you need it.
        </p>
        <ol class="mt-8 space-y-5">
          <li class="flex gap-4">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#e6f4ec] text-sm font-extrabold text-[#176b4b]">
              1
            </span>
            <span class="pt-1 text-sm leading-6 text-[#526158]">
              Scan the queue QR code or open the shared link.
            </span>
          </li>
          <li class="flex gap-4">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#e6f4ec] text-sm font-extrabold text-[#176b4b]">
              2
            </span>
            <span class="pt-1 text-sm leading-6 text-[#526158]">
              Join the right service and keep your ticket page handy.
            </span>
          </li>
          <li class="flex gap-4">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#e6f4ec] text-sm font-extrabold text-[#176b4b]">
              3
            </span>
            <span class="pt-1 text-sm leading-6 text-[#526158]">
              Follow your status and position while you wait.
            </span>
          </li>
        </ol>
      </div>

      <div
        id="for-businesses"
        class="rounded-[2rem] bg-[#173d2e] p-7 text-white shadow-[0_22px_60px_rgba(23,61,46,.18)] sm:p-10"
      >
        <span class="grid size-12 place-items-center rounded-2xl bg-white/10 text-[#b9e4c8]">
          <.icon name="hero-users" class="size-6" />
        </span>
        <p class="mt-7 text-xs font-extrabold uppercase tracking-[.16em] text-[#a9d6b8]">
          For businesses
        </p>
        <h2 class="mt-3 text-3xl font-black tracking-[-.05em] sm:text-4xl">
          A calmer view of the day.
        </h2>
        <p class="mt-4 text-sm leading-7 text-white/70">
          Give your team a shared view of who is waiting and what comes next. Set up locations, services, and queues, then manage tickets as visitors move through service.
        </p>
        <ul class="mt-7 space-y-3 text-sm text-white/85">
          <li class="flex items-center gap-3">
            <.icon name="hero-check-circle" class="size-5 text-[#a9d6b8]" />
            Live queue board with clear ticket states
          </li>
          <li class="flex items-center gap-3">
            <.icon name="hero-check-circle" class="size-5 text-[#a9d6b8]" />
            Queue links and QR codes for your visitors
          </li>
          <li class="flex items-center gap-3">
            <.icon name="hero-check-circle" class="size-5 text-[#a9d6b8]" />
            Staff roles and location-based access
          </li>
          <li class="flex items-center gap-3">
            <.icon name="hero-check-circle" class="size-5 text-[#a9d6b8]" />
            Optional recurring signup schedules
          </li>
        </ul>
        <a
          href="/sign-in"
          class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-extrabold text-[#173d2e] transition hover:bg-[#eaf5ed]"
        >
          Staff sign in <.icon name="hero-arrow-right" class="size-4" />
        </a>
      </div>
    </section>

    <section class="px-5 pb-16 sm:px-8 sm:pb-20 lg:px-10">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 rounded-[2rem] border border-[#dfeae1] bg-[#eaf5ed] p-7 sm:p-10 md:flex-row md:items-center">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[.16em] text-[#218158]">
            Ready when you are
          </p>
          <h2 class="mt-2 text-2xl font-black tracking-[-.04em] sm:text-3xl">
            Make the next wait a little easier.
          </h2>
          <p class="mt-2 text-sm leading-6 text-[#647168]">
            Visitors can join with a queue link. Staff can sign in to manage their workspace.
          </p>
        </div>
        <a
          href="/sign-in"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-[#176b4b] px-5 py-3.5 text-sm font-extrabold text-white transition hover:bg-[#10523a]"
        >
          Go to staff sign in <.icon name="hero-arrow-right" class="size-4" />
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-[#e4ebe5] bg-white px-5 py-7 sm:px-8 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 text-xs text-[#87948b] sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="font-extrabold tracking-tight text-[#176b4b]">kewkew</a>
      <p>Simple queue management for businesses and the people they serve.</p>
      <a href="/sign-in" class="font-bold text-[#176b4b] hover:underline">Staff sign in</a>
    </div>
  </footer>
</div>
