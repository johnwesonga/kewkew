<main class="min-h-screen bg-[#f4f7f4] px-4 py-8 text-[#17251f] sm:px-6 sm:py-12">
  <div class="mx-auto max-w-3xl">
    <header class="mb-12 flex items-center gap-3">
      <div class="grid size-10 place-items-center rounded-2xl bg-[#176b4b] text-xl font-extrabold text-white">
        k
      </div>
      <div>
        <p class="text-lg font-extrabold tracking-tight">Kewkew</p>
        <p class="text-[10px] font-bold uppercase tracking-[.16em] text-[#718078]">
          Queue, without the wait
        </p>
      </div>
    </header>

    <p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#176b4b]">
      {@location.name}
    </p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-[-.055em] sm:text-5xl">Choose a service</h1>
    <p class="mt-4 text-base leading-7 text-[#718078]">
      Select the service you need. You can review its queue before joining.
    </p>

    <section id="visitor-service-options" class="mt-8 grid gap-4">
      <p
        :if={@services == []}
        id="visitor-no-services"
        class="rounded-2xl bg-white p-6 text-sm text-[#5f6d64]"
      >
        No services are available at this location right now. Please ask staff for help.
      </p>

      <%= for %{queue: queue, service: service, availability: availability} <- @services do %>
        <%= if availability.state == :open do %>
          <a
            id={"visitor-service-#{queue.public_slug}"}
            href={"/q/#{queue.public_slug}"}
            class="block rounded-2xl border border-[#e4eae5] bg-white p-5 shadow-sm transition hover:border-[#a9cbb7] hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#176b4b] sm:p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-lg font-extrabold">{service.name}</h2>
                <p class="mt-1 text-sm text-[#5f6d64]">{queue.name}</p>
                <p
                  :if={service.description not in [nil, ""]}
                  class="mt-3 text-sm leading-6 text-[#718078]"
                >
                  {service.description}
                </p>
              </div>
              <span class="shrink-0 rounded-full bg-[#e6f4ec] px-3 py-2 text-[11px] font-extrabold text-[#176b4b]">
                {availability.label}
              </span>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-[#176b4b]">
              View queue <.icon name="hero-arrow-right" class="size-4" />
            </span>
          </a>
        <% else %>
          <article
            id={"visitor-service-#{queue.public_slug}"}
            aria-disabled="true"
            class="rounded-2xl border border-[#e4eae5] bg-[#f9fbf9] p-5 opacity-75 sm:p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-lg font-extrabold">{service.name}</h2>
                <p class="mt-1 text-sm text-[#5f6d64]">{queue.name}</p>
                <p class="mt-3 text-sm leading-6 text-[#718078]">{availability.message}</p>
              </div>
              <span class="shrink-0 rounded-full bg-[#eef2ef] px-3 py-2 text-[11px] font-extrabold text-[#66736b]">
                {availability.label}
              </span>
            </div>
          </article>
        <% end %>
      <% end %>
    </section>

    <footer class="mt-16 border-t border-[#e1e8e2] pt-5 text-center text-[10px] text-[#87948b]">
      Powered by Kewkew · Queue information is provided by {@location.name}
    </footer>
  </div>
</main>
