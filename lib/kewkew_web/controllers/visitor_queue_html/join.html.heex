<main class="grid min-h-screen place-items-center bg-[#f4f7f4] px-4 py-8 text-[#17251f] sm:px-6">
  <section class="w-full max-w-lg rounded-3xl border border-[#e4eae5] bg-white p-6 shadow-[0_18px_50px_rgba(26,52,39,.09)] sm:p-9">
    <a href={"/q/#{@queue.public_slug}"} class="text-sm font-bold text-[#176b4b] hover:underline">
      ← Queue details
    </a>

    <p class="mt-8 text-xs font-extrabold uppercase tracking-[.15em] text-[#176b4b]">
      {@location.name}
    </p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-[-.05em]">Join {@service.name}</h1>
    <p class="mt-2 text-sm text-[#5f6d64]">{@queue.name}</p>

    <div
      :if={@queue.identity_policy == :anonymous}
      id="visitor-join-anonymous"
      class="mt-7 rounded-2xl bg-[#f4f7f4] p-5"
    >
      <p class="text-sm leading-6 text-[#5f6d64]">
        You’ll receive a number for this queue. No name or contact details are needed.
      </p>
    </div>

    <div
      :if={@queue.identity_policy == :name_required}
      id="visitor-join-name-required"
      class="mt-7 rounded-2xl bg-[#f4f7f4] p-5"
    >
      <p class="text-sm leading-6 text-[#5f6d64]">
        This queue asks for your first and last name before you join.
      </p>
    </div>

    <p
      :if={@message}
      id="visitor-join-message"
      role="status"
      class="mt-5 rounded-xl bg-[#fff4d8] p-4 text-sm leading-6 text-[#765515]"
    >
      {@message}
    </p>

    <.form
      :if={@can_join?}
      for={@form}
      action={"/q/#{@queue.public_slug}/join"}
      method="post"
      id="visitor-join-form"
      class="mt-6"
    >
      <input type="hidden" name="join[attempt_token]" value={@form[:attempt_token].value} />
      <button
        id="visitor-confirm-join"
        type="submit"
        class="w-full rounded-xl bg-[#176b4b] px-5 py-4 text-sm font-extrabold text-white transition hover:bg-[#10523a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#176b4b]"
      >
        Get my queue number
      </button>
    </.form>

    <a
      :if={!@can_join?}
      id="visitor-join-unavailable-back"
      href={"/q/#{@queue.public_slug}"}
      class="mt-6 block rounded-xl bg-[#e9eeea] px-5 py-4 text-center text-sm font-extrabold text-[#5f6d64]"
    >
      Back to queue details
    </a>
  </section>
</main>
