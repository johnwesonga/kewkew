<main class="grid min-h-screen place-items-center bg-[#f4f7f4] px-4 py-8 text-[#17251f] sm:px-6">
  <section
    id="visitor-ticket"
    data-status-url={"/t/#{@tracking_token}/status"}
    data-ticket-status={Atom.to_string(@ticket.status)}
    class="w-full max-w-lg rounded-3xl border border-[#e4eae5] bg-white p-7 text-center shadow-[0_18px_50px_rgba(26,52,39,.09)] sm:p-10"
  >
    <div class="mx-auto grid size-12 place-items-center rounded-2xl bg-[#e6f4ec] text-xl font-extrabold text-[#176b4b]">
      k
    </div>
    <p class="mt-5 text-xs font-extrabold uppercase tracking-[.15em] text-[#176b4b]">
      {case @ticket.status do
        :called -> "It’s your turn"
        :serving -> "Being served"
        :completed -> "Service complete"
        :cancelled -> "Ticket cancelled"
        :no_show -> "Call missed"
        _ -> "You’re in line"
      end}
    </p>
    <h1 id="visitor-ticket-heading" class="mt-3 text-3xl font-extrabold tracking-[-.05em]">
      {cond do
        @ticket.status == :completed -> "Thank you"
        @ticket.status == :called -> "Please follow the instructions below"
        @ticket.status == :serving -> "Your service is underway"
        true -> "Your ticket number"
      end}
    </h1>
    <p
      id="visitor-ticket-number"
      class="mt-5 text-6xl font-extrabold tracking-[-.06em] text-[#176b4b]"
    >
      {@ticket.ticket_number}
    </p>
    <p class="mt-5 text-sm font-bold">{@service.name}</p>
    <p class="mt-1 text-sm text-[#718078]">{@location.name}</p>
    <p
      id="visitor-ticket-status"
      aria-live="polite"
      class="mt-6 inline-flex rounded-full bg-[#e6f4ec] px-4 py-2 text-xs font-extrabold text-[#176b4b]"
    >
      {@status_label}
    </p>

    <section
      :if={@ticket.status == :completed}
      id="visitor-completion-message"
      aria-live="polite"
      class="mt-7 rounded-2xl border border-[#cde5d5] bg-[#f1f8f3] p-5 text-left"
    >
      <p class="text-base font-extrabold text-[#176b4b]">
        Service for ticket ##{@ticket.ticket_number} at {@service.name} is complete.
      </p>
      <p class="mt-2 text-sm leading-6 text-[#526158]">
        You’re all set. You can leave when ready.
      </p>
    </section>

    <section
      :if={@ticket.status == :called}
      id="visitor-called-action"
      aria-live="polite"
      role="status"
      class="mt-7 rounded-2xl border border-[#f0d89b] bg-[#fff8e7] p-5 text-left"
    >
      <p class="text-base font-extrabold text-[#765515]">Your number has been called.</p>
      <p id="visitor-called-instructions" class="mt-2 text-sm leading-6 text-[#5f5131]">
        {if(@service.visitor_instructions in [nil, ""],
          do: "Please speak with staff at #{@location.name} and show them your ticket number.",
          else: @service.visitor_instructions
        )}
      </p>
    </section>

    <section
      :if={@ticket.status == :serving}
      id="visitor-serving-message"
      aria-live="polite"
      role="status"
      class="mt-7 rounded-2xl border border-[#cde5d5] bg-[#f1f8f3] p-5 text-left"
    >
      <p class="text-base font-extrabold text-[#176b4b]">Staff are serving you now.</p>
      <p class="mt-2 text-sm leading-6 text-[#526158]">
        Please follow the staff’s instructions.
      </p>
    </section>

    <div
      :if={@ticket.status not in [:completed, :cancelled, :no_show]}
      class="mt-7 rounded-2xl bg-[#f4f7f4] p-4 text-center"
    >
      <p class="text-[10px] font-extrabold uppercase tracking-[.12em] text-[#87948b]">
        Position
      </p>
      <div
        id="visitor-queue-progress"
        class="visitor-queue-progress"
        data-position={@position}
        data-progress-active={@ticket.status == :waiting && not is_nil(@position)}
        aria-hidden="true"
      >
        <span class="visitor-queue-progress-track"></span>
        <span class="visitor-queue-progress-marker">
          <.icon name="hero-user" class="size-4" />
        </span>
      </div>
      <p id="visitor-ticket-position" aria-live="polite" class="mt-2 text-lg font-extrabold">
        {if(@position, do: "#{@position} in line", else: "No longer waiting")}
      </p>
    </div>

    <%= if @ticket.status == :waiting do %>
      <form
        id="visitor-cancel-form"
        action={"/t/#{@tracking_token}/cancel"}
        method="post"
        data-confirm="Leave this queue? Your place in line will be cancelled."
      >
        <input type="hidden" name="_csrf_token" value={@csrf_token} />
        <button
          id="visitor-cancel-ticket"
          type="submit"
          class="mt-5 w-full rounded-xl border border-[#e8c8c4] px-4 py-3 text-sm font-extrabold text-[#9b3f35] hover:bg-[#fff7f5]"
        >
          Leave queue
        </button>
      </form>
    <% end %>

    <p
      :if={@ticket.status == :cancelled}
      id="visitor-cancelled-next-step"
      class="mt-6 text-sm leading-6 text-[#718078]"
    >
      This ticket was cancelled and no longer has a place in line. If you still need service, ask staff whether you can rejoin.
    </p>

    <p
      :if={@ticket.status == :no_show}
      id="visitor-no-show-next-step"
      class="mt-6 text-sm leading-6 text-[#718078]"
    >
      This ticket is no longer active because staff could not reach you when called. If you’re still waiting, speak to staff about your next step.
    </p>

    <%= if @ticket.status in [:called, :serving] do %>
      <p id="visitor-cancellation-policy" class="mt-5 text-sm text-[#718078]">
        If you need to leave, please speak to staff.
      </p>
    <% end %>

    <p :if={@ticket.status != :completed} class="mt-6 text-sm leading-6 text-[#718078]">
      Your ticket number identifies your place in line. The private link below is what lets you return to this page.
    </p>

    <div :if={@ticket.status != :completed} class="mt-6 text-left">
      <label for="visitor-tracking-link" class="text-xs font-extrabold text-[#5f6d64]">
        Your private tracking link
      </label>
      <input
        id="visitor-tracking-link"
        type="text"
        readonly
        value={@tracking_url}
        class="mt-2 w-full rounded-xl border border-[#dce5dd] bg-white px-3 py-3 text-xs text-[#5f6d64]"
      />
      <button
        id="copy-visitor-tracking-link"
        type="button"
        data-copy-target="visitor-tracking-link"
        class="mt-3 w-full rounded-xl border border-[#b8d2c1] px-4 py-3 text-sm font-extrabold text-[#176b4b] hover:bg-[#f4f7f4]"
      >
        Copy private link
      </button>
      <p
        id="visitor-tracking-link-status"
        class="mt-2 min-h-5 text-xs text-[#176b4b]"
        aria-live="polite"
      >
      </p>
    </div>
  </section>
</main>
