<Layouts.app flash={@flash}>
  <main class="container mx-auto max-w-xl p-8">
    <h1 class="text-2xl font-bold">Invitation unavailable</h1>
    <p class="mt-2">
      This invitation is invalid, expired, or has already been used. Ask the organization administrator to send a new invitation.
    </p>
  </main>
</Layouts.app>
